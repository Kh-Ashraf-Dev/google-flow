# Copy to .env.local and fill in. Without a key the app runs in mock mode (no Google calls, no cost).

# Neon Postgres (pooled connection string). Use a dev branch locally, never main.
DATABASE_URL=

# Vertex AI service account with permission to use Vertex AI in a billing-enabled project.
VERTEX_KEY_FILE=
# On Fly, use VERTEX_KEY_JSON with the JSON content or its base64 representation.
# VERTEX_LOCATION=us-central1

# Hard stop on Google spend per day, in USD.
DAILY_SPEND_CAP_USD=5

# Force mock mode even with a key set.
# MOCK_PROVIDER=1

# Model ids, in case Google renames them. Check the Vertex AI model docs.
# HELPER_MODEL=gemini-3.8-flash
# HELPER_FALLBACK_MODEL=gemini-3.5-flash
# Override the Nano Banana 2 model; the other models are in server/config.ts.
# IMAGE_MODEL=gemini-3.1-flash-image

# fal.ai key for Wan 2.5 and Kling 3 Standard (https://fal.ai/dashboard/keys). Without it those
# two models say fal.ai isn't set up; the Google models keep working.
# FAL_KEY=
